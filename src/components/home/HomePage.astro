---
import { Icon } from 'astro-icon/components';
import { config, homeFor } from '~/lib/config';
import { visible, type Page, type WikiArticle } from '~/lib/content';
import { localizePath } from '~/lib/url';
import { t, formatDate } from '~/i18n/ui';
import GuideCard from '~/components/article/GuideCard.astro';
import AdSlot from '~/components/ads/AdSlot.astro';
import ExploreModule from './ExploreModule.astro';
import Faq from './Faq.astro';
interface Props { page: Page; pool: WikiArticle[]; }
const { page, pool } = Astro.props;
const { locale } = page;
const home = homeFor(locale)!;
const entries = visible(pool, locale);
const featured = home.featuredGuides.map(key => entries.find(entry => entry.key === key)).filter((entry): entry is WikiArticle => !!entry);
const recent = home.updates?.enabled ? entries.slice(0, home.updates.limit) : [];
---
<div class="home-page">
  {home.hero && <section class="hero">
    {home.hero.image && <img class="hero-art" src={home.hero.image} alt={home.hero.imageAlt ?? ''} width="768" height="432" fetchpriority="high" decoding="async"/>}
    <div class="hero-shade"></div><div class="hero-content"><p class="eyebrow"><span></span>{home.hero.eyebrow}</p><p class="hero-game">{config.gameName} <span>WIKI</span></p><h1 data-pagefind-meta="title">{home.hero.title.split('\n').map((line,index) => <>{index > 0 && <br/>}{line}</>)}</h1><p class="hero-description">{home.hero.description}</p><div class="hero-actions">{home.hero.primary && <a class="button primary" href={home.hero.primary.href}>{home.hero.primary.label}<Icon name="lucide:arrow-right"/></a>}{home.hero.secondary && <a class="button secondary" href={home.hero.secondary.href}>{home.hero.secondary.label}<Icon name="lucide:compass"/></a>}</div></div>
    {home.hero.stats.length > 0 && <dl class="hero-stats">{home.hero.stats.map(stat => <div><dt>{stat.label}</dt><dd>{stat.value}</dd><a href={stat.source} rel="noopener noreferrer" target="_blank">{stat.asOf} ↗</a></div>)}</dl>}
    {config.demo && <span class="art-caption">{t(locale, 'conceptArt')}</span>}
  </section>}
  {!home.hero && <h1 data-pagefind-meta="title">{config.gameName}</h1>}
  {home.hero && home.hero.shortcuts.length > 0 && <nav class="hero-shortcuts" aria-label={t(locale, 'featured')}><span><Icon name="lucide:zap"/>{t(locale, 'jumpInto')}</span>{home.hero.shortcuts.map(shortcut => <a href={shortcut.href}>{shortcut.label}<span aria-hidden="true">↗</span></a>)}</nav>}
  <AdSlot slot="native-banner"/>
  <AdSlot slot="home-banner"/>
  {home.quickStart.length > 0 && <section class="quick-start-section"><div class="section-heading"><div><p class="section-eyebrow">{t(locale, 'startHere')}</p><h2>{home.quickStartTitle}</h2></div><span class="section-note">{t(locale, 'quickStartNote')}</span></div><div class="quick-start">{home.quickStart.map((item,index) => <a href={item.href}><span class="quick-icon"><Icon name={`lucide:${item.icon ?? 'compass'}`}/></span><span class="quick-number">{item.label ?? String(index + 1).padStart(2, '0')}</span><h3>{item.title}<span aria-hidden="true">↗</span></h3><p>{item.description}</p></a>)}</div></section>}
  <div class="home-content-grid"><div class="home-primary">
    {featured.length > 0 && <section class="featured-section"><div class="section-heading"><div><p class="section-eyebrow">{t(locale, 'featuredLabel')}</p><h2>{home.featuredTitle}</h2></div></div><div class="featured-grid">{featured.map(entry => <GuideCard entry={entry} image/>)}</div></section>}
    {home.explore && <section class="explore-section"><div class="section-heading"><h2>{home.explore.title}</h2><span class="section-note">{entries.length} {t(locale, 'articles')}</span></div><div class="explore-grid">{home.explore.modules.filter(module => module.enabled).sort((a,b) => a.order-b.order).map(module => <ExploreModule module={module} locale={locale}/>)}</div></section>}
  </div><aside class="home-rail">
    <AdSlot slot="home-rectangle"/>
    {recent.length > 0 && <section class="recent-section"><div class="section-heading"><h2><Icon name="lucide:history"/>{home.updates!.title}</h2><span class="live-dot"></span></div><p class="section-eyebrow">{t(locale, 'latest')}</p><ol>{recent.map(entry => <li><span class="update-date"><time datetime={entry.data.lastModified}>{formatDate(entry.data.lastModified, locale)}</time><span></span></span><a href={entry.path}>{entry.data.title}<span aria-hidden="true">↗</span></a><p>{entry.data.description}</p></li>)}</ol><a class="text-link" href={localizePath('/recent', locale)}>{t(locale, 'viewAll')}<Icon name="lucide:arrow-right"/></a></section>}
    {entries.length > 0 && <section class="wiki-contents"><p class="section-eyebrow">{t(locale, 'fieldGuide')}</p><h3>{t(locale, 'navigation')}</h3><ul>{config.navigation.filter(nav => entries.some(entry => entry.category === nav.slug)).map(nav => <li><a href={localizePath(`/${nav.slug}`, locale)}><Icon name={`lucide:${nav.icon}`}/><span>{nav.labels[locale] ?? nav.label}</span><small>{entries.filter(entry => entry.category === nav.slug).length}</small></a></li>)}</ul></section>}
  </aside></div>
  {home.aboutGame && <section class="game-overview">{home.aboutGame.image && <img src={home.aboutGame.image} alt={home.aboutGame.imageAlt ?? ''} width="768" height="432" loading="lazy"/>}<div><p class="section-eyebrow">{t(locale, 'aboutGameEyebrow')}</p><h2>{home.aboutGame.title}</h2><p>{home.aboutGame.description}</p>{home.aboutGame.facts.length > 0 && <dl>{home.aboutGame.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>}</div></section>}
  <Faq items={home.faq} locale={locale}/>
  {home.finalCta && <section class="final-cta"><Icon name="lucide:compass"/><div><h2>{home.finalCta.title}</h2><p>{home.finalCta.description}</p></div><a class="button primary" href={home.finalCta.href}>{home.finalCta.label}<Icon name="lucide:arrow-right"/></a></section>}
</div>
