---
interface Props { columns: string[]; rows: string[][]; caption?: string; }
const { columns, rows, caption } = Astro.props;
if (rows.some(row => row.length !== columns.length)) throw new Error('Table: every row must match the number of columns.');
---
{columns.length > 0 && rows.length > 0 && <div class="table-scroll not-prose"><table>{caption && <caption>{caption}</caption>}<thead><tr>{columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{rows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div>}
