{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-realistichomedefenseguides-wiki",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "www.realistichomedefenseguides.wiki/*",
      "zone_name": "realistichomedefenseguides.wiki"
    },
    {
      "pattern": "realistichomedefenseguides.wiki/ads.txt",
      "zone_name": "realistichomedefenseguides.wiki"
    }
  ]
}
